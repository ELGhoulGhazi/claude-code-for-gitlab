# GitLab Claude runner — copy to .env
#
# This service used to trigger a GitLab pipeline. It now runs the @claude job
# itself, in a container on this host, and reports to Control Room. Nothing
# about the job changed: same image, same entrypoints, same MR.

# ---- GitLab ---------------------------------------------------------------
GITLAB_URL=https://gitlab.example.com
# Used to read projects and create the claude/* branches.
GITLAB_TOKEN=
# Secret configured on each project's webhook (Settings → Webhooks).
WEBHOOK_SECRET=
# Guards /admin/enable and /admin/disable.
ADMIN_TOKEN=

# ---- Claude ---------------------------------------------------------------
CLAUDE_CODE_OAUTH_TOKEN=
# Token Claude pushes and comments with. Falls back to GITLAB_TOKEN.
CLAUDE_CODE_GL_ACCESS_TOKEN=
CLAUDE_MODEL=claude-opus-4-8
TRIGGER_PHRASE=@claude
# ANTHROPIC_API_KEY=            # alternative to the OAuth token

# ---- Control Room ---------------------------------------------------------
# Where run metrics and live activity are posted. Must be reachable from here.
CONTROL_ROOM_URL=http://control-room:8088
# Same value as Control Room's INGEST_TOKEN.
CONTROL_ROOM_TOKEN=
# Browser-facing Control Room URL, used for the link in Claude's issue comment.
CONTROL_ROOM_PUBLIC_URL=https://control-room.example.com
# Secret Control Room presents to POST /run. Generate with:
#   openssl rand -hex 32
RUNNER_TOKEN=

# ---- Runner ---------------------------------------------------------------
CLAUDE_RUNNER_IMAGE=claude-runner:latest
# Per-run working directories. Must be writable, and on a disk with room for a
# full checkout plus build output per concurrent run.
RUNNER_WORK_ROOT=/srv/claude-runs
# Path to the container entrypoint, resolved from this directory.
RUNNER_ENTRYPOINT=runner/run.sh
# GitLab's job queue used to bound this. Nothing else will.
MAX_CONCURRENT_RUNS=2
# Was `timeout: 70m` on the job.
RUN_TIMEOUT_MIN=70
# Reproduces the pipeline's `services: docker:28-dind`, needed by the
# Testcontainers suites. Set false for projects whose tests don't need Docker.
RUNNER_DIND=true
DIND_IMAGE=docker:28-dind
# never | onfailure | always — failed runs are kept so they can be inspected.
KEEP_WORKDIR=onfailure

# Git identity for Claude's commits.
GIT_AUTHOR_NAME=Claude Bot
GIT_AUTHOR_EMAIL=claude-bot@example.com

# ---- Optional -------------------------------------------------------------
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW=900
# DISCORD_WEBHOOK_URL=
PORT=3000
